---
import type { ContentItem } from "@/utils/content/items";
import { useTranslations, useLocale } from "@/i18n";
import ItemRow from "./ItemRow.astro";

type Props = {
  items: ContentItem[];
  /** Heading text; defaults to "Related reading". */
  title?: string;
};

const { items, title } = Astro.props;

const t = useTranslations(useLocale(Astro));
const mixed = new Set(items.map(item => item.type)).size > 1;
---

{items.length > 0 && (
  <section aria-labelledby="related-heading">
    <h2 id="related-heading" class="section-title">
      {title ?? t.related.title}
    </h2>
    <ul class="index">
      {items.map(item => (
        <ItemRow item={item} showKind={mixed} />
      ))}
    </ul>
  </section>
)}
