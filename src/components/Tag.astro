---
import { useLocale } from "@/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";

type Props = {
  tag: string;
  tagName: string;
  category?: boolean;
};

const { tag, tagName, category = false } = Astro.props;

const locale = useLocale(Astro);
const href = getRelativeLocaleUrl(locale, `tags/${tag}/`);
---

<li>
  <a href={href} transition:name={tag} class="tag">
    #<span class={category ? "p-category" : undefined}>{tagName}</span>
  </a>
</li>
