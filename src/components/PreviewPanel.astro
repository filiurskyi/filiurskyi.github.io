---
import config from "@/config";
import { useLocale, useTranslations } from "@/i18n";

/**
 * Floating preview panel (appearance.preview): switch palette, ambient
 * light, wordmark glow and statusline live. Changes are kept in
 * sessionStorage for this browser tab only; the inline script in Layout
 * applies them before the first paint.
 */
const { palettes, palette, ambient, wordmarkGlow, statusline } =
  config.appearance;
const options = (record: Record<string, { label: string }>) =>
  Object.entries(record).map(([value, { label }]) => ({ value, label }));
const dark = options(palettes.dark);
const light = options(palettes.light);
const ambientLabels = {
  none: "off",
  light: "glow",
  breathe: "breathing glow",
  dawn: "dawn tint",
};
// What "reset" goes back to.
const defaults = JSON.stringify({
  dark: palette.dark,
  light: palette.light,
  ambient,
  glow: wordmarkGlow,
  statusline,
});
const t = useTranslations(useLocale(Astro));
const docsUrl =
  "https://github.com/glowing-space/starglow/blob/main/docs/02-configuration.md";
---

<details class="preview-panel" data-defaults={defaults} data-pagefind-ignore>
  <summary>
    <span class="preview-label">
      preview<span class="preview-more">: palette · effects</span>
    </span>
  </summary>
  <form class="preview-body" aria-label={t.a11y.themePreview}>
    <p class="preview-note">
      <a href={docsUrl}>starglow theme options</a> · this&nbsp;tab&nbsp;only
    </p>
    <label>
      <span>dark</span>
      <select name="dark">
        {dark.map(o => (
          <option value={o.value}>{o.label}</option>
        ))}
      </select>
    </label>
    <label>
      <span>light</span>
      <select name="light">
        {light.map(o => (
          <option value={o.value}>{o.label}</option>
        ))}
      </select>
    </label>
    <label>
      <span>ambient</span>
      <select name="ambient">
        {Object.entries(ambientLabels).map(([value, label]) => (
          <option value={value}>{label}</option>
        ))}
      </select>
    </label>
    <label class="preview-check">
      <input type="checkbox" name="glow" />
      <span>wordmark glow</span>
    </label>
    <label class="preview-check">
      <input type="checkbox" name="statusline" />
      <span>statusline</span>
    </label>
    <button type="reset">reset</button>
  </form>
</details>

<script>
  const KEY = "starglow-preview";
  type State = Record<string, string | boolean>;

  const root = document.documentElement;
  const read = (): State => {
    try {
      return JSON.parse(sessionStorage.getItem(KEY) ?? "{}") as State;
    } catch {
      return {};
    }
  };
  const write = (state: State) =>
    sessionStorage.setItem(KEY, JSON.stringify(state));

  /** Session mode for theme.ts; null goes back to the visitor's own. */
  const setMode = (mode: string | null) =>
    document.dispatchEvent(new CustomEvent("starglow:theme", { detail: mode }));

  function apply(state: State) {
    for (const key of ["dark", "light", "ambient"]) {
      if (typeof state[key] === "string") root.dataset[key] = state[key];
    }
    for (const key of ["glow", "statusline"]) {
      if (typeof state[key] === "boolean")
        root.toggleAttribute(`data-${key}`, state[key]);
    }
  }

  function setup() {
    const panel = document.querySelector<HTMLDetailsElement>(".preview-panel");
    const form = panel?.querySelector("form");
    const summary = panel?.querySelector("summary");
    if (!panel || !form || !summary) return;
    const initial = JSON.parse(panel.dataset.defaults ?? "{}") as State;

    const fill = (state: State) => {
      for (const [key, value] of Object.entries(state)) {
        const field = form.elements.namedItem(key);
        if (field instanceof HTMLInputElement) field.checked = Boolean(value);
        else if (field instanceof HTMLSelectElement)
          field.value = String(value);
      }
    };
    fill({ ...initial, ...read() });
    panel.open = read().open === true;

    panel.addEventListener("toggle", () =>
      write({ ...read(), open: panel.open })
    );
    panel.addEventListener("keydown", event => {
      if (event.key !== "Escape" || !panel.open) return;
      panel.open = false;
      summary.focus();
    });

    form.addEventListener("change", event => {
      const target = event.target as HTMLInputElement | HTMLSelectElement;
      const state = read();
      state[target.name] =
        target instanceof HTMLInputElement && target.type === "checkbox"
          ? target.checked
          : target.value;
      // Show the palette just picked: switch to its mode for this tab.
      if (
        (target.name === "dark" || target.name === "light") &&
        root.dataset.theme !== target.name
      ) {
        state.theme = target.name;
        setMode(target.name);
      }
      write(state);
      apply(state);
    });
    form.addEventListener("reset", event => {
      event.preventDefault();
      write({ open: panel.open });
      apply(initial);
      fill(initial);
      setMode(null);
    });
  }

  // The visitor's own toggle wins over the session mode.
  document.addEventListener("click", event => {
    if (!(event.target as Element).closest?.("#theme-btn")) return;
    const state = read();
    delete state.theme;
    write(state);
  });

  setup();
  document.addEventListener("astro:after-swap", () => {
    apply(read());
    setup();
  });
</script>
