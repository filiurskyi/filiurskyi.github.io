---
import { BADGE_ICONS, BADGE_TEXT, badgeIcon, badgeRects } from "@/utils/badges";
import { getAssetPath } from "@/utils/withBase";

/**
 * One 88x31 pixel badge: bevelled frame, an 11x11 icon in 2px cells and a
 * one-line label. Colours are CSS tokens, so both themes and hover work
 * without script.
 */
type Props = {
  type: string;
  href: string;
  label?: string;
  title?: string;
  rel?: string;
  class?: string;
  /** Site path of an 88x31 image shown instead of the drawn badge. */
  image?: string;
};

const { type, label, title, rel, class: className, image } = Astro.props;
const href = /^\/(?!\/)/.test(Astro.props.href)
  ? getAssetPath(Astro.props.href)
  : Astro.props.href;
const known = Object.hasOwn(BADGE_ICONS, type);
const icon = badgeIcon(type);
const text = label ?? (known ? icon.label : type);
const name = title ?? (known ? icon.title : type);
const rects = badgeRects(icon.bitmap, `--badge-${known ? type : "link"}`);
// Long labels are squeezed into the 56px text area.
const squeeze =
  text.length > BADGE_TEXT.squeezeAbove
    ? { textLength: BADGE_TEXT.width, lengthAdjust: "spacingAndGlyphs" }
    : {};
---

<a class:list={["b88", className]} href={href} rel={rel} title={name}>
  {image ? (
    <img
      src={getAssetPath(image)}
      width="88"
      height="31"
      alt={name}
      loading="lazy"
      decoding="async"
    />
  ) : (
    <svg
      width="88"
      height="31"
      viewBox="0 0 88 31"
      shape-rendering="crispEdges"
      aria-hidden="true"
    >
      {rects.map(({ x, y, width, height, fill }) => (
        <rect
          x={x || undefined}
          y={y || undefined}
          width={width}
          height={height}
          fill={`var(${fill})`}
        />
      ))}
      <text
        x={BADGE_TEXT.x}
        y={BADGE_TEXT.y}
        text-anchor="middle"
        class="b88-text"
        {...squeeze}
      >
        {text}
      </text>
    </svg>
  )}
  {!image && <span class="sr-only">{name}</span>}
</a>
