---
import type { CollectionEntry } from "astro:content";
import { getProjectUrl } from "@/utils/content/projects";
import IndexRow from "./IndexRow.astro";
import { useTranslations, useLocale } from "@/i18n";

type Props = {
  project: CollectionEntry<"projects">;
  /** Show the description under the row (full lists, not the home page). */
  withDescription?: boolean;
};

const { project, withDescription = false } = Astro.props;
const { title, description, status, draft } = project.data;
const t = useTranslations(useLocale(Astro));
---

<IndexRow
  href={getProjectUrl(project.id)}
  title={title}
  draft={draft}
  end={t.project.status[status].toLowerCase()}
  status={status}
  desc={withDescription ? description : undefined}
/>
