---
import { useLocale } from "@/i18n";
import type { HTMLAttributes } from "astro/types";
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  pageTitle: string;
  pageDesc?: string;
  /** The h1 stays in the outline but is not shown (home and 404). */
  hideTitle?: boolean;
  /** Inline style of the h1, e.g. a view-transition name. */
  titleStyle?: Record<string, string>;
  /** Listing pages record themselves as the target of the back link. */
  trackBack?: boolean;
  entry?: boolean;
} & Omit<HTMLAttributes<"main">, "id">;

const {
  pageTitle,
  pageDesc,
  hideTitle = false,
  titleStyle,
  trackBack = true,
  entry = false,
  class: className,
  ...attrs
} = Astro.props;

const locale = useLocale(Astro);
const backUrl = config.features.showBackButton
  ? Astro.url.pathname
  : getRelativeLocaleUrl(locale, "");
const hasMeta = Astro.slots.has("meta");
---

<main
  data-back-url={trackBack ? backUrl : undefined}
  {...attrs}
  id="main-content"
  class:list={["site-main", { "h-entry": entry }, className]}
>
  <div class="band page-head">
    <div class="col">
      {hasMeta && (
        <div class="head-row">
          <slot name="meta" />
        </div>
      )}
      <h1
        class:list={["page-title", { "sr-only": hideTitle, "p-name": entry }]}
        style={titleStyle}
      >
        {pageTitle}
      </h1>
      {pageDesc && <p class="page-desc">{pageDesc}</p>}
      <slot name="head" />
    </div>
  </div>
  <div class="band-edge" aria-hidden="true"></div>
  <div class="page-body col">
    <slot />
  </div>
</main>

<script>
  document.addEventListener("astro:page-load", () => {
    const mainContent: HTMLElement | null =
      document.querySelector("#main-content");
    const backUrl = mainContent?.dataset?.backUrl;
    if (backUrl) {
      sessionStorage.setItem("backUrl", backUrl);
    }
  });
</script>
