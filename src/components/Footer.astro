---
import type { HTMLAttributes } from "astro/types";
import Badge88 from "./Badge88.astro";
import { getFooterLinks } from "@/utils/footer";
import { useTranslations, useLocale } from "@/i18n";
import config from "@/config";

type Props = HTMLAttributes<"footer"> & { hCard?: boolean };

const { class: className, hCard = false, ...attrs } = Astro.props;

const locale = useLocale(Astro);
const t = useTranslations(locale);
const currentYear = new Date().getFullYear();

const { credit, badges, extra, nav } = await getFooterLinks(locale, {
  contact: t.footer.contact,
  smallWeb: t.footer.smallWeb,
  source: t.footer.source,
});
---

<footer class:list={["site-footer col", className]} {...attrs}>
  <div class="colophon">
    <span>
      {`© ${currentYear} `}
      <span class={hCard ? "p-name" : undefined}>{config.site.author}</span>
      {hCard && config.person.jobTitle && (
        <data class="p-job-title" value={config.person.jobTitle} hidden />
      )}
      {credit && (
        <>
          <span class="credit-sep" aria-hidden="true">
            {" · "}
          </span>
          <span class="nowrap">
            {t.footer.poweredBy}{" "}
            <a class="credit" href={credit}>
              starglow
            </a>
          </span>
        </>
      )}
    </span>
    {nav.length > 0 && (
      <nav aria-label={t.a11y.footerNav}>
        {nav.map((link, index) => (
          <>
            {index > 0 && <span aria-hidden="true"> · </span>}
            <a href={link.href}>{link.label}</a>
          </>
        ))}
      </nav>
    )}
  </div>
  {(badges.length > 0 || extra.length > 0) && (
    <div class="footer-base">
      {badges.length > 0 && (
        <ul class="badges" aria-label={t.footer.elsewhere}>
          {badges.map(link => (
            <li>
              <Badge88
                type={link.type}
                href={link.url}
                label={link.label}
                title={link.title}
                rel={link.rel}
                class={hCard && link.rel === "me" ? "u-url" : undefined}
              />
            </li>
          ))}
        </ul>
      )}
      {extra.length > 0 && (
        <p class="footer-extra">
          {extra.map((link, index) => (
            <>
              {index > 0 && <span aria-hidden="true"> · </span>}
              <a href={link.href}>{link.label}</a>
            </>
          ))}
        </p>
      )}
    </div>
  )}
</footer>
