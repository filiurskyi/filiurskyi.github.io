---
import type { HTMLAttributes } from "astro/types";
import Badge88 from "./Badge88.astro";
import { getFooterLinks } from "@/utils/footer";
import { useTranslations, useLocale } from "@/i18n";
import config from "@/config";

type Props = HTMLAttributes<"footer"> & { hCard?: boolean };

const { class: className, hCard = false, ...attrs } = Astro.props;

const locale = useLocale(Astro);
const t = useTranslations(locale);
const currentYear = new Date().getFullYear();

const { credit, badges, pages, legal, source } = await getFooterLinks(locale, {
  contact: t.footer.contact,
  smallWeb: t.footer.smallWeb,
  source: t.footer.source,
});
---

<footer class:list={["site-footer col", className]} {...attrs}>
  {(pages.length > 0 || legal.length > 0) && (
    <nav class="footer-pages" aria-label={t.a11y.footerNav}>
      <ul>
        {pages.map(link => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
        {legal.length > 0 && (
          <li class="footer-legal">
            <ul class="footer-inline" aria-label={t.footer.legal}>
              {legal.map(link => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </li>
        )}
      </ul>
    </nav>
  )}
  <div class="footer-base">
    <p>
      {`© ${currentYear} `}
      <span class={hCard ? "p-name" : undefined}>{config.site.author}</span>
      {hCard && config.person.jobTitle && (
        <data class="p-job-title" value={config.person.jobTitle} hidden />
      )}
    </p>
    {(credit || source) && (
      <ul class="footer-inline">
        {credit && (
          <li>
            <span>
              {`${t.footer.poweredBy} `}
              <a class="credit" href={credit}>
                starglow
              </a>
            </span>
          </li>
        )}
        {source && (
          <li>
            <a href={source.href}>{source.label}</a>
          </li>
        )}
      </ul>
    )}
  </div>
  {badges.length > 0 && (
    <ul class="badges" aria-label={t.footer.elsewhere}>
      {badges.map(link => (
        <li>
          <Badge88
            type={link.type}
            href={link.url}
            label={link.label}
            title={link.title}
            rel={link.rel}
            image={link.image}
            class={hCard && link.rel === "me" ? "u-url" : undefined}
          />
        </li>
      ))}
    </ul>
  )}
</footer>
