---
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import config from "@/config";
import { useTranslations, tplStr, useLocale } from "@/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";
import { resolveTimezone } from "@/utils/resolveTimezone";

dayjs.extend(utc);
dayjs.extend(timezone);

type Props = {
  /** Mono kind word, e.g. "post" or "note". */
  kind: string;
  /** The main date: a post's publication date, a note's effective date. */
  date?: string | Date;
  /** Shown instead of a date when there is none (a note's folder year). */
  year?: string;
  /** A later modification date, shown as "updated". */
  modDatetime?: string | Date | null;
  timezone?: string;
  draft?: boolean;
  minutes: number;
  author?: string;
  summary?: string;
};

const {
  kind,
  date,
  year,
  modDatetime,
  timezone: postTimezone,
  draft,
  minutes,
  author,
  summary,
} = Astro.props;

const locale = useLocale(Astro);
const t = useTranslations(locale);
const homeUrl = getRelativeLocaleUrl(locale, "");
const zone = resolveTimezone(postTimezone ?? config.site.timezone);

const main = date ? dayjs(date).tz(zone) : null;
const updated = modDatetime ? dayjs(modDatetime).tz(zone) : null;
const isUpdated =
  main !== null && updated !== null && updated.valueOf() > main.valueOf();
const format = "YYYY-MM-DD";
---

<p class="post-meta meta" data-pagefind-ignore>
  <span>{kind}</span>
  <span aria-hidden="true"> · </span>
  {main ? (
    <time class="dt-published" datetime={main.toISOString()}>
      {main.format(format)}
    </time>
  ) : (
    <time class="dt-published" datetime={year}>
      {year}
    </time>
  )}
  {isUpdated && updated && (
    <>
      <span aria-hidden="true"> · </span>
      <span>
        {t.post.updatedAt.toLowerCase()}{" "}
        <time class="dt-updated" datetime={updated.toISOString()}>
          {updated.format(format)}
        </time>
      </span>
    </>
  )}
  <span aria-hidden="true"> · </span>
  <span>{tplStr(t.post.readingTime, { minutes })}</span>
  {author && (
    <span class="p-author h-card" hidden>
      {author === config.site.author ? (
        <a class="p-name u-url" href={homeUrl}>
          {author}
        </a>
      ) : (
        <span class="p-name">{author}</span>
      )}
    </span>
  )}
  {summary && <data class="p-summary" value={summary} hidden />}
  {import.meta.env.DEV && draft && (
    <>
      <span aria-hidden="true"> · </span>
      <span>{t.post.draft.toLowerCase()}</span>
    </>
  )}
</p>
