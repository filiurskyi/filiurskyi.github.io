---
import type { GetStaticPaths } from "astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import ItemRow from "@/components/ItemRow.astro";
import Footer from "@/components/Footer.astro";
import Pagination from "@/components/Pagination.astro";
import { getPostItems } from "@/utils/content/items";
import { useTranslations, useLocale } from "@/i18n";
import config from "@/config";

export const getStaticPaths = (async ({ paginate }) => {
  return paginate(await getPostItems(), { pageSize: config.posts.perPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const locale = useLocale(Astro);
const t = useTranslations(locale);
---

<Layout title={`${t.pages.postsTitle} | ${config.site.title}`}>
  <Header />

  <Main pageTitle={t.pages.postsTitle}>
    {page.data.length > 0 && (
      <ul class="index">
        {page.data.map(item => (
          <ItemRow item={item} />
        ))}
      </ul>
    )}
    <Pagination {page} />
  </Main>

  <Footer />
</Layout>
