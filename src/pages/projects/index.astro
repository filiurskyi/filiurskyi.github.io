---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import ProjectRow from "@/components/ProjectRow.astro";
import Footer from "@/components/Footer.astro";
import { getVisibleProjects, sortProjects } from "@/utils/content/projects";
import { useTranslations, useLocale } from "@/i18n";
import config from "@/config";

const locale = useLocale(Astro);
const t = useTranslations(locale);

const projects = sortProjects(await getVisibleProjects());
---

<Layout title={`${t.pages.projectsTitle} | ${config.site.title}`}>
  <Header />

  <Main pageTitle={t.pages.projectsTitle}>
    {projects.length > 0 && (
      <ul class="index">
        {projects.map(project => (
          <ProjectRow project={project} withDescription />
        ))}
      </ul>
    )}
  </Main>

  <Footer />
</Layout>
