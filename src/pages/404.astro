---
import { getAssetPath } from "@/utils/withBase";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/components/Main.astro";
import { useTranslations, useLocale } from "@/i18n";
import config from "@/config";

const locale = useLocale(Astro);
const t = useTranslations(locale);

// A big 404 over a shell that cannot find the page; <b> marks the accent.
const ART = [
  " _  _    ___   _  _",
  "| || |  / _ \\ | || |",
  "| || |_| | | || || |_",
  "|__   _| |_| ||__   _|",
  "   |_|  \\___/    |_|",
  "",
  "$ cd <span data-requested-path>/requested/page</span>",
  "<b>cd: no such file or directory</b>",
  "$ <b>_</b>",
].join("\n");
---

<!-- GitHub Pages serves this document at /404.html; /404/ does not exist. -->
<Layout
  title={`${t.notFound.title} | ${config.site.title}`}
  canonicalURL={new URL(getAssetPath("404.html"), Astro.site).href}
  noindex
>
  <Header />

  <Main pageTitle={t.notFound.message} hideTitle>
    <pre class="ascii" slot="head" aria-hidden="true" set:html={ART} />
    <p class="not-found-text">{t.notFound.body}</p>
  </Main>

  <Footer />
</Layout>

<script>
  import { stripBase } from "@/utils/withBase";

  // "$ cd " plus the path stays within 37 columns, so it never wraps on a phone.
  const MAX_PATH = 32;

  function decode(path: string) {
    try {
      return decodeURIComponent(path);
    } catch {
      return path;
    }
  }

  function showRequestedPath() {
    const target = document.querySelector("[data-requested-path]");
    if (!target) return;
    const chars = [...decode(stripBase(location.pathname))];
    target.textContent =
      chars.length > MAX_PATH
        ? `${chars.slice(0, MAX_PATH - 1).join("")}…`
        : chars.join("");
  }

  document.addEventListener("astro:page-load", showRequestedPath);
</script>
