---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import IndexRow from "@/components/IndexRow.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { getAllItems } from "@/utils/content/items";
import { slugifyAll } from "@/utils/slugify";
import { tplStr, useTranslations, useLocale } from "@/i18n";
import config from "@/config";

const items = await getAllItems();
const tags = getUniqueTags(items).map(({ tag, tagName }) => ({
  tag,
  tagName,
  count: items.filter(item => slugifyAll(item.tags).includes(tag)).length,
}));

const locale = useLocale(Astro);
const t = useTranslations(locale);
---

<Layout title={`${t.pages.tagsTitle} | ${config.site.title}`}>
  <Header />

  <Main pageTitle={t.pages.tagsTitle}>
    {tags.length > 0 && (
      <ul class="index">
        {tags.map(({ tag, tagName, count }) => (
          <IndexRow
            href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
            title={`#${tagName}`}
            end={String(count)}
            endLabel={tplStr(t.pages.tagCount, { count })}
          />
        ))}
      </ul>
    )}
  </Main>

  <Footer />
</Layout>
