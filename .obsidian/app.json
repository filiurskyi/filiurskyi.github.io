    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "starglow.config.ts",
    "tsconfig.json",
    "vitest.config.ts",
    "templates/note.md",
    "templates/post.md",
    "templates/project.md",
    "src/assets",
    "src/components",
    "src/custom",
    "src/i18n",
    "src/layouts",
    "src/pages",
    "src/scripts",
    "src/styles",
