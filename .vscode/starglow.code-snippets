{
  "Frontmatter": {
    "scope": "markdown",
    "prefix": "frontmatter",
    "body": [
      "---",
      "title: $1",
      "description: $2",
      "pubDatetime: $CURRENT_YEAR-$CURRENT_MONTH-${CURRENT_DATE}T$CURRENT_HOUR:$CURRENT_MINUTE:$CURRENT_SECOND.000$CURRENT_TIMEZONE_OFFSET",
      "modDatetime: $3",
      "draft: ${4|true,false|}",
      "tags: []",
      "---",
    ],
    "description": "Adds the frontmatter block for a blog post. The file belongs in src/content/blog/YYYY/.",
  },
  "Blog Template": {
    "scope": "markdown",
    "prefix": "template",
    "body": [
      "${1:frontmatter}",
      "",
      "${2: Introductory Sentence}",
      "",
      "## ${3: heading 1}",
    ],
    "description": "Adds the template for a blog post in src/content/blog/YYYY/. Trigger the snippet modal on the 'frontmatter' line to insert the frontmatter snippet.",
  },
  "Note Frontmatter": {
    "scope": "markdown",
    "prefix": "note-frontmatter",
    "body": [
      "---",
      "title: $1",
      "tags: [$2]",
      "draft: ${3|true,false|}",
      "---",
      "",
      "$0",
    ],
    "description": "Adds the frontmatter block for a note. The file belongs in src/content/notes/YYYY/. Notes take their dates from git; description is optional.",
  },
  "Project Frontmatter": {
    "scope": "markdown",
    "prefix": "project-frontmatter",
    "body": [
      "---",
      "title: $1",
      "description: $2",
      "status: ${3|active,maintained,archived|}",
      "stack: [$4]",
      "draft: ${5|true,false|}",
      "---",
    ],
    "description": "Adds the frontmatter block for a project in src/content/projects/. Add githubUrl, docsUrl or websiteUrl as needed and leave the file empty below the closing ---.",
  },
}
